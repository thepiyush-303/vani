# QuickPass Voice Agent — Environment Configuration
# Copy to .env and fill in values.

# ── WebSocket & HTTP ports ────────────────────────────────────
PORT=8765
HTTP_PORT=3000

# ── Faster-Whisper (final STT → LLM) ──────────────────────────
# Model name: "tiny.en" (fastest, ~1GB RAM) | "base.en" (balanced) | "small.en"
WHISPER_MODEL=base.en
# Directory where model weights are downloaded
WHISPER_MODEL_DIR=/tmp/whisper_models

# Vocabulary biasing — names/jargon Whisper mishears. Comma-separated terms,
# and/or one term per line in vocab.txt. Keep the list short (long prompts cost
# decode time). Leave both unset to disable biasing.
VANI_VOCAB=
VANI_VOCAB_FILE=vocab.txt

# ── Vosk (live streaming captions) ────────────────────────────
# Live interim captions only — Whisper still produces the text sent to the LLM.
# Download a model from https://alphacephei.com/vosk/models
#   vosk-model-small-en-us-0.15 (40MB) is recommended for low latency.
# Unzip into models/ . If the model is missing, the server still runs — live
# captions are simply disabled.
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
# Bytes of PCM handed to the recognizer at a time (4000 ≈ 125ms @16kHz).
# Lower = snappier captions, more CPU.
VOSK_CHUNK_BYTES=4000

# ── Piper TTS ─────────────────────────────────────────────────
# Download models from: https://github.com/rhasspy/piper/releases
# If PIPER_MODEL_PATH is unset, TTS is disabled (server starts without Piper).
PIPER_BINARY=piper
PIPER_MODEL_PATH=/models/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=/models/en_US-lessac-medium.onnx.json

# ── Groq API ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# ── Gemini API ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_PROVIDER=gemini # "groq" or "gemini"

# ── v2.0: Todoist Tool (Phase 10) ──────────────────────────────
# Get your personal API token from: https://todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=
